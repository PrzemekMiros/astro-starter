---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroFull from "../components/home/HeroFull.astro";
import FeaturedWork from "../components/home/FeaturedWork.astro";
import Testimonials from "../components/home/Testimonials.astro";
import CallToAction from "../components/home/CallToAction.astro";
import BentoGrid from "../components/home/BentoGrid.astro";
import Offer from "../components/home/Offer.astro";
import LatestPosts from "../components/home/LatestPosts.astro";
import ClientsLogos from "../components/home/ClientsLogos.astro";
---
 
<BaseLayout
  title="Projektowanie stron internetowych"
  description="Projektuję i tworzę nowoczesne strony internetowe: od strategii i projektu po wdrożenie i wsparcie. Szybko, czytelnie i z myślą o wynikach."
  showHero={false}
>
	<HeroFull />
	<ClientsLogos />
	<Offer />
	<FeaturedWork />
	<Testimonials limit={8} />
	<LatestPosts />
	<CallToAction />
</BaseLayout>
