---
import { Image } from 'astro:assets';
import ActionButton from '../../components/ActionButton.astro';
import portrait from '../../assets/images/global/avatar.jpg';
import { localHeading } from '../../data/local-landing.js';
const { town, lead } = Astro.props;
---
<section class="local-hero relative bg-black py-12 text-white md:py-20">
  <div class="pointer-events-none absolute inset-y-0 left-1/2 w-screen -translate-x-1/2 bg-black"></div>
  <div class="relative grid items-center gap-10 lg:grid-cols-[1.5fr_1fr]">
    <div>
      <p class="mb-6 text-sm font-medium text-[var(--accent)]">Projektowanie i tworzenie stron WWW</p>
      <h1 class="max-w-3xl text-4xl font-semibold leading-[1.12] tracking-tight md:text-5xl" aria-label={localHeading(town)}>Strony internetowe <span class="hero-location">dla firm z {town.trim()} i okolic</span></h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-300">Pomogę ustalić, czego potrzebuje Twoja firma. Przygotuję indywidualny projekt i wdrożę stronę, na której jasno przedstawisz ofertę i ułatwisz klientom kontakt.</p>
      {lead && <p class="mt-4 max-w-2xl leading-relaxed text-gray-300">{lead}</p>}
      <div class="mt-8 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
        <ActionButton href="#wycena" className="min-h-12">Otrzymaj bezpłatną wycenę</ActionButton>
        <a href="#realizacje" class="py-3 font-semibold underline underline-offset-4">Zobacz realizacje</a>
      </div>
    </div>
    <div class="hero-contact rounded-2xl border border-white/15 bg-white/5 p-6 md:p-8">
      <div class="hero-person">
        <Image src={portrait} width={96} height={96} alt="Przemek Miros" class="h-20 w-20 rounded-full object-cover" loading="eager" />
        <div><p class="font-semibold text-white">Przemek Miros</p><p class="mt-1 text-sm text-gray-400">Projektant i wykonawca</p></div>
      </div>
      <h2 class="text-2xl font-semibold">Porozmawiajmy o Twojej stronie</h2>
      <p class="mt-4 leading-relaxed text-gray-300">Nazywam się Przemek Miros. Kontaktujesz się bezpośrednio ze mną — od pierwszej rozmowy po publikację strony.</p>
      <a href="tel:+48788660190" class="mt-6 inline-block text-2xl font-semibold text-white">+48 788 660 190</a>
      <p class="mt-3 text-sm text-gray-300">Na początek wystarczy pomysł. Szczegóły ustalimy wspólnie.</p>
      <div class="hero-scope" aria-label="Zakres współpracy"><span>Projekt</span><span>Wdrożenie</span><span>Wsparcie</span></div>
    </div>
  </div>
</section>
