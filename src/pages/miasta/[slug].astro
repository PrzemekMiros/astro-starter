---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MiastaHero from "../../layouts/heroes/MiastaHero.astro";
import ClientsLogos from "../../components/home/ClientsLogos.astro";
import FeaturedWork from "../../components/home/FeaturedWork.astro";
import Testimonials from "../../components/home/Testimonials.astro";
import ContactForm from "../../components/ContactForm.astro";
import LocalServiceDetails from "../../components/LocalServiceDetails.astro";
import FaqList from "../../components/FaqList.astro";
import { landingQuestions } from "../../data/local-landing.js";
import { slugifyTitle } from "../../lib/slugifyTitle";
import '../../styles/local-landings.css';

export const prerender = true;

export function getStaticPaths() {
  const entries = import.meta.glob("../../content/miasta/*.md", { eager: true });
  return Object.entries(entries).map(([file, entry]) => {
    const fileSlug = file.split("/").pop().replace(".md", "");
    const title = entry.frontmatter?.title;
    const titleSlug = title ? slugifyTitle(title) : undefined;
    const slug = titleSlug ?? fileSlug;
    return {
      params: { slug },
      props: { miasto: { ...entry.frontmatter, slug, citySlug: fileSlug }, Content: entry.Content },
    };
  });
}

const { miasto, Content } = Astro.props;
if (!miasto) return Astro.redirect("/miasta");
const questions = landingQuestions(miasto.faq);
---

<BaseLayout title={miasto.title ?? miasto.slug} description={miasto.description} showHero={false} robots={miasto.robots} localLanding>
  <MiastaHero town={miasto.town} lead={miasto.lead} />
  <ClientsLogos />
  <Testimonials limit={8} />
  <FeaturedWork id="realizacje" />
  <LocalServiceDetails />
  {Content && <section class="local-context pb-16" aria-labelledby="lokalnie">
    <div><p class="local-eyebrow">Twoja firma w internecie</p><h2 id="lokalnie" class="mb-6 text-3xl font-semibold">Strony WWW dla firm z {miasto.town}</h2></div>
    <article class="prose prose-xl prose-slate max-w-none dark:prose-invert local-content">
      <Content />
    </article>
  </section>}
  <section class="local-faq pb-16" aria-labelledby="pytania">
    <p class="local-eyebrow">Pytania i odpowiedzi</p>
    <h2 id="pytania" class="mb-8 text-3xl font-semibold">Przed pierwszą rozmową</h2>
    <FaqList questions={questions} />
  </section>
  <section id="wycena" class="mb-20 grid gap-8 rounded-2xl border border-[var(--border)] bg-[#fbfbff] p-5 md:p-10 lg:grid-cols-2" aria-labelledby="wycena-title">
    <div class="quote-intro">
      <p class="mb-4 text-sm font-semibold text-[var(--accent)]">Bezpłatna wycena strony</p>
      <h2 id="wycena-title" class="text-3xl font-semibold md:text-4xl">Opowiedz o swojej firmie</h2>
      <p class="mt-5 max-w-lg leading-relaxed text-[var(--muted)]">Napisz, czym się zajmujesz i jakiej strony potrzebujesz. Pomogę ustalić dalsze kroki.</p>
      <p class="mt-6">Wolisz porozmawiać? <a class="inline-block py-2 font-semibold underline" href="tel:+48788660190">+48 788 660 190</a></p>
      <p class="mt-3 text-sm text-[var(--muted)]">Twoje zapytanie trafi bezpośrednio do mnie.</p>
    </div>
    <div class="quote-form"><ContactForm city={miasto.citySlug} sourcePage={Astro.url.pathname} /></div>
  </section>
</BaseLayout>
<style>
  #wycena, #realizacje { scroll-margin-top: 1.5rem; }
  .local-content { max-width: 80ch; }
  .local-content :global(h2), .local-content :global(h3) { margin-top: 1.5em; margin-bottom: .6em; font-weight: 600; }
  .local-content :global(h2) { font-size: 1.5rem; }
  .local-content :global(h3) { font-size: 1.25rem; }
  .local-content :global(p), .local-content :global(ul), .local-content :global(ol) { margin-bottom: 1em; line-height: 1.75; }
  .local-content :global(ul) { list-style: disc; padding-left: 1.4rem; }
  .local-content :global(ol) { list-style: decimal; padding-left: 1.4rem; }
  .local-content :global(a) { text-decoration: underline; }
</style>
