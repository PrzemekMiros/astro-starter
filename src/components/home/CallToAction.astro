---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/sections/blog-responsive.jpg";

const cta = {
  title: "Gotowy na nową stronę?",
  description: "Zadzwoń lub napisz do mnie, żeby omówić swój projekt i otrzymać wycenę.",
  button: { label: "Skontaktuj się", href: "/kontakt/" },
};
---

<section class="relative mb-20 md:mb-24 overflow-hidden rounded-2xl">
  <div class="grid grid-cols-1 lg:grid-cols-[2.1fr_1fr]">
    
    <div class="relative flex flex-col justify-center bg-black px-8 py-18 md:pb-20 md:pt-18 md:px-16 z-10">
      <div class="max-w-xl">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold leading-[1.1] tracking-tight text-white mb-6">
          {cta.title}
        </h2>
        <p class="text-gray-400 text-lg mb-8">
          {cta.description}
        </p>

                      <a href="/kontakt/" title="Skontaktuj się" class="group relative inline-flex h-12 items-center justify-center rounded-md bg-[var(--accent)] px-6 font-medium text-neutral-200"><span>{cta.button.label}</span><div class="relative ml-1 h-5 w-5 overflow-hidden"><div class="absolute transition-all duration-200 group-hover:-translate-y-5 group-hover:translate-x-4"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 -translate-x-4"><path d="M3.64645 11.3536C3.45118 11.1583 3.45118 10.8417 3.64645 10.6465L10.2929 4L6 4C5.72386 4 5.5 3.77614 5.5 3.5C5.5 3.22386 5.72386 3 6 3L11.5 3C11.6326 3 11.7598 3.05268 11.8536 3.14645C11.9473 3.24022 12 3.36739 12 3.5L12 9.00001C12 9.27615 11.7761 9.50001 11.5 9.50001C11.2239 9.50001 11 9.27615 11 9.00001V4.70711L4.35355 11.3536C4.15829 11.5488 3.84171 11.5488 3.64645 11.3536Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg></div></div></a>
      </div>

      <div class="hidden lg:block absolute right-0 bottom-0 w-26 h-26 bg-[var(--accent)] translate-x-26 z-20"></div>
    </div>

    <div class="hidden md:block relative min-h-[250px] lg:min-h-full bg-gray-100">
      <div class="absolute inset-0 overflow-hidden">
        <Image
          src={heroImage}
          alt="CTA Background"
          class="size-full object-cover grayscale opacity-90"
          widths={[480, 768, 1024]}
          sizes="(max-width: 1024px) 100vw, 480px"
          loading="lazy"
        />
      </div>
      
      <div class="hidden lg:block absolute left-0 bottom-26 w-26 h-26 bg-white -translate-x-26 z-20"></div>
      
    </div>

  </div>
</section>
