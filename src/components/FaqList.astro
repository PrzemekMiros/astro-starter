---
const { questions = [], headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}`;
const answered = questions.filter((item) => typeof item.title === 'string' && item.title.trim() && typeof item.answer === 'string' && item.answer.trim());
---
<div class="grid gap-4 md:grid-cols-2" itemscope itemtype="https://schema.org/FAQPage">
  {answered.map((item) => (
    <article class="rounded-xl border border-black/20 bg-white px-5 py-6 md:px-6" itemscope itemtype="https://schema.org/Question" itemprop="mainEntity">
      <Heading class="text-xl font-semibold text-[var(--text)]" itemprop="name">{item.title}</Heading>
      <div itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
        <p class="mt-3 leading-relaxed text-[var(--muted)]" itemprop="text">{item.answer}</p>
      </div>
    </article>
  ))}
</div>

