---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ActionButton from "../../components/ActionButton.astro";
---

<BaseLayout
  title="Dziękuję za kontakt"
  description="Informacje po przesłaniu formularza kontaktowego."
  showHero={false}
  robots="noindex"
>


  <section class="pb-16 pt-12 md:pb-20 md:pt-20">
    <div class="rounded-2xl border border-[var(--border)] bg-[#fbfbff] p-8 md:p-12 text-center">
      <p class="mb-3 text-xs uppercase tracking-[0.12em] text-[var(--accent)]">Kontakt</p>
      <h1 class="mb-4 text-3xl font-semibold text-black/90 md:text-4xl">Dziękuję za kontakt</h1>
      <p class="mx-auto mb-8 max-w-2xl text-base text-[var(--muted)]">
        Jeśli przesłałeś formularz, odpowiedź otrzymasz na podany adres e-mail. W razie problemów z wysłaniem zadzwoń: <a href="tel:+48788660190" class="underline">+48 788 660 190</a>.
      </p>
      <ActionButton href="/" title="Strona główna">Wróć na stronę główną</ActionButton>
    </div>
  </section>
</BaseLayout>
