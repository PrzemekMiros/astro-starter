---
import settings from "../content/ustawienia.json";
import { ClientRouter } from "astro:transitions";
import LoadingIndicator from "astro-loading-indicator/component";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "./heroes/PageHero.astro";
import "../styles/global.css";
import { getImage } from "astro:assets";
import ogImage from "../assets/images/opengraph/opengraph.png";
import faviconSvg from "../assets/images/global/favicon.svg";
import faviconPng from "../assets/images/global/favicon.png";
import zalandoSemiExpanded from "../assets/fonts/Zalando_Sans_SemiExpanded/ZalandoSansSemiExpanded-VariableFont_wght.ttf?url";

const assets = import.meta.glob("/src/assets/**/*", { eager: true });
const resolveAsset = (path) => {
  if (!path) return null;
  const entry = assets[`/src${path}`];
  return entry?.default ?? null;
};

const { title, description, showHero = true, robots, heroMeta, pageStructuredData, localLanding = false } = Astro.props;
const { site, url } = Astro;
const pageTitle = title ? ` ${title} - ${settings.siteTitle}` : settings.siteTitle;
const metaDescription = description ?? settings.metaDescription;
const logoAsset = resolveAsset(settings.logo);
const processedOgImage = await getImage({ src: ogImage, format: 'png' });
const ogImageUrl = site ? new URL(processedOgImage.src, site).toString() : processedOgImage.src;
const siteUrl = site ? new URL("/", site).toString() : "";
const organizationId = site ? `${siteUrl}#organization` : "";
const websiteStructuredData = site
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": organizationId,
          name: "Przemek Miros",
          url: siteUrl,
          description: "Projektowanie i tworzenie stron internetowych: strategia, projekt, wdrożenie i wsparcie.",
          logo: logoAsset?.src ? new URL(logoAsset.src, site).toString() : undefined,
          image: ogImageUrl,
          email: "kontakt@przemekmiros.pl",
          telephone: "+48 788 660 190",
          address: {
            "@type": "PostalAddress",
            postalCode: "05-660",
            addressLocality: "Warka",
            addressCountry: "PL",
          },
          areaServed: {
            "@type": "Country",
            name: "Polska",
          },
          contactPoint: {
            "@type": "ContactPoint",
            contactType: "customer service",
            email: "kontakt@przemekmiros.pl",
            telephone: "+48 788 660 190",
            availableLanguage: "Polish",
          },
          founder: {
            "@type": "Person",
            name: "Przemek Miros",
          },
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}#website`,
          url: siteUrl,
          name: settings.siteTitle,
          inLanguage: "pl-PL",
          publisher: { "@id": organizationId },
        },
      ],
    }
  : null;
---

<html lang="pl">
  <head>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      if (!window.__googleTagInitialized) {
        window.__googleTagInitialized = true;
        let consent = null;
        try { consent = JSON.parse(localStorage.getItem('cookie-consent-v1') || 'null'); } catch {}
        const marketing = consent?.marketing === true ? 'granted' : 'denied';
        window.gtag('consent', 'default', {
          ad_storage: marketing,
          ad_user_data: marketing,
          ad_personalization: marketing,
          analytics_storage: consent?.analytics === true ? 'granted' : 'denied',
        });
        window.gtag('js', new Date());
      }
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-THGT723D" transition:persist="google-tag-manager"></script>
    <script>
      import '../scripts/google-ads.js';
    </script>
    <slot name="head" />
    <meta name="google-site-verification" content="_uLorccZIpY-NlRb036yMXgs2lvctMD5A_aSlU6HRa4" />
    <meta charset="utf-8" />
    <link
      rel="preload"
      as="font"
      type="font/ttf"
      href={zalandoSemiExpanded}
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href={faviconSvg.src} />
    <link rel="icon" type="image/png" href={faviconPng.src} />
    <link rel="ard" href="/.well-known/ard.json" type="application/json" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots === 'noindex' ? 'noindex' : 'index'} />
    
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" /> 
    <meta property="og:site_name" content={settings.siteTitle} />
    <meta property="og:image" content={ogImageUrl} />
    {site ? <meta property="og:url" content={new URL(url.pathname, site).toString()} /> : null}
    {site ? <link rel="canonical" href={new URL(url.pathname, site).toString()} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    {websiteStructuredData ? <script type="application/ld+json" set:html={JSON.stringify(websiteStructuredData)} /> : null}
    {pageStructuredData ? <script type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} /> : null}
    <ClientRouter />
    <LoadingIndicator color="var(--accent)" height="3px" animationDuration={400} threshold={200} />
    <style is:inline>
      ::view-transition-old(root) {
        animation: fade-out 160ms ease;
      }
      ::view-transition-new(root) {
        animation: fade-in 160ms ease;
      }
      @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }
    </style>
  </head>
  <body class="min-h-screen bg-[var(--bg)] font-sans text-[var(--text)]">
    <main data-local-landing={localLanding ? '' : undefined} class="mx-auto flex min-h-screen w-full max-w-[1320px] flex-col px-4 sm:px-10 lg:px-12">
      <Header settings={settings} logoAsset={logoAsset} localLanding={localLanding} />
      {showHero && title ? <PageHero title={title} lead={description} meta={heroMeta} /> : null}
      <slot />
      <Footer localLanding={localLanding} />
    </main>
    <script is:inline>
      const registerSiteWebMcpTools = () => {
        const modelContext = document.modelContext ?? navigator.modelContext;
        if (!modelContext || window.__siteInfoWebMcpRegistered) return;

        window.__siteInfoWebMcpRegistered = true;
        modelContext.registerTool({
          name: "get_site_information",
          title: "Informacje o stronie Przemka Mirosa",
          description: "Pobiera publiczne informacje o usługach, danych kontaktowych i najważniejszych zasobach witryny przemekmiros.pl.",
          inputSchema: {
            type: "object",
            properties: {},
            additionalProperties: false,
          },
          annotations: {
            readOnlyHint: true,
            untrustedContentHint: false,
            consequentialHint: false,
          },
          async execute(_input, options) {
            const response = await fetch("/api/site.json", {
              headers: { Accept: "application/json" },
              signal: options?.signal,
            });

            if (!response.ok) {
              throw new Error(`Nie udało się pobrać informacji o stronie (${response.status}).`);
            }

            return response.json();
          },
        }).catch((error) => {
          window.__siteInfoWebMcpRegistered = false;
          console.warn("Nie udało się zarejestrować narzędzia WebMCP.", error);
        });
      };

      registerSiteWebMcpTools();
      document.addEventListener("astro:page-load", registerSiteWebMcpTools);

      const applyBlurLazy = () => {
        document.querySelectorAll("main img").forEach((img) => {
          if (img.dataset.blurLazy === "true") return;
          img.dataset.blurLazy = "true";
          if (img.getAttribute("loading") !== "eager") {
            img.setAttribute("loading", "lazy");
          }
          img.setAttribute("decoding", "async");
          img.classList.add("blur-sm", "transition-[filter]", "duration-500");
          const clearBlur = () => img.classList.remove("blur-sm");
          if (img.complete) {
            clearBlur();
          } else {
            img.addEventListener("load", clearBlur, { once: true });
            img.addEventListener("error", clearBlur, { once: true });
          }
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", applyBlurLazy);
      } else {
        applyBlurLazy();
      }
      document.addEventListener("astro:page-load", applyBlurLazy);
      document.addEventListener("astro:after-swap", applyBlurLazy);
    </script>
  </body>
</html>
