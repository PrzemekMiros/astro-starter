---
import ActionButton from '../../components/ActionButton.astro';
import HeroBackdrop from '../../components/home/HeroBackdrop.astro';
import { localHeading } from '../../data/local-landing.js';
const { town, lead } = Astro.props;
---
<section class="home-section relative text-white">
  <div class="relative">
  <HeroBackdrop />
  <div class="relative grid grid-cols-1 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] pb-8 pt-38 md:pb-34 md:pt-50">
    <div class="space-y-6 max-w-xl">
      <p class="mb-6 text-sm font-medium text-[var(--accent)]">Projektowanie i tworzenie stron WWW</p>
      <h1 class="text-4xl md:text-5xl text-white font-semibold tracking-tight leading-[1.1] mb-8" aria-label={localHeading(town)}>Strony internetowe <span class="text-white/50">dla firm z {town.trim()} i okolic</span></h1>
      <p class="max-w-2xl text-md text-gray-300 mb-10">Pomogę ustalić, czego potrzebuje Twoja firma. Przygotuję indywidualny projekt i wdrożę stronę, na której jasno przedstawisz ofertę i ułatwisz klientom kontakt.</p>
      {lead && <p class="max-w-2xl text-md text-gray-300">{lead}</p>}
      <div class="flex flex-col items-start gap-8 xl:flex-row xl:items-center">
        <ActionButton href="#wycena" className="min-h-12">Otrzymaj bezpłatną wycenę</ActionButton>
        <a href="#realizacje" class="py-3 font-semibold underline underline-offset-4">Zobacz realizacje</a>
      </div>
    </div>
  </div>
  </div>
</section>
